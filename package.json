{
  "name": "teste-tecnico",
  "version": "1.0.0",
  "private": true,
  "description": "Converte um JSONL de clubes de futebol em clubs.csv e players.csv, com leitura incremental para bases grandes.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build",
    "test": "tsx --test tests/clube.test.ts tests/e2e.test.ts tests/helpers.test.ts tests/reader.test.ts",
    "typecheck": "tsc"
  },
  "keywords": ["jsonl", "csv", "etl", "batch"],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "csv-stringify": "^6.8.3"
  }
}
