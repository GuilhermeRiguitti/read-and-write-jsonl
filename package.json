{
  "name": "teste-tecnico",
  "version": "1.0.0",
  "private": true,
  "description": "Converte um JSONL de clubes de futebol em clubs.csv e players.csv, com leitura incremental para bases grandes.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --test",
    "typecheck": "tsc"
  },
  "keywords": ["jsonl", "csv", "etl", "batch"],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "csv-stringify": "^6.8.3"
  }
}
